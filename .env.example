# OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY=

# Primary AI Provider: 'openrouter' or 'gemini'
AI_PROVIDER=openrouter

# 3-AI TIERED PIPELINE (Global Free Models)
AI_TIER_1=openrouter/free
AI_TIER_2=liquid/lfm-2.5-2.6b:free
AI_TIER_3=nvidia/nemotron-3.5-lightning:free

# OpenAI API Key (sk-...)
OPENAI_API_KEY=

# Manager Model Configuration
MANAGER_MODEL=gpt-4o

# Universal Fast Backup AI Model (Gemini 3.8 Flash for all workers)
BACKUP_AI_MODEL=google/gemini-3.8-flash

# Worker 3-AI Tiers (Designated Primary -> Gemini 3.8 Flash Backup -> Safety Fallback)
# 1. Victoria (Operations & QC Manager)
VICTORIA_AI_1=gpt-4o
VICTORIA_AI_2=google/gemini-3.8-flash
VICTORIA_AI_3=nvidia/nemotron-3-super-120b-a12b:free

# 2. Ray (Lead Researcher)
RAY_AI_1=google/gemma-4-31b-it:free
RAY_AI_2=google/gemini-3.8-flash
RAY_AI_3=nvidia/nemotron-3.5-lightning:free

# 3. Wendy (Creative Writer & Marketer)
WENDY_AI_1=dots-studio/dots-3-note-preview:free
WENDY_AI_2=google/gemini-3.8-flash
WENDY_AI_3=liquid/lfm-2.5-2.6b:free

# 4. Sam (Customer Support Specialist)
SAM_AI_1=nvidia/nemotron-3.5-lightning:free
SAM_AI_2=google/gemini-3.8-flash
SAM_AI_3=openrouter/free

# Backup Direct Gemini API Key (Optional)
GEMINI_API_KEY=

# Generous rate limits (calls per hour)
RATE_LIMIT_PER_AGENT_HOURLY=1000
RATE_LIMIT_GLOBAL_HOURLY=5000

# Server Port
PORT=3000

# Executive Master Passcode (Restricted to Founder)
OFFICE_ACCESS_CODE=
AUTH_SESSION_SECRET=
